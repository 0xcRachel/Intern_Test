{
  "info": {
    "name": "ExamPlatform API Collection",
    "_postman_id": "c1f7b889-4a92-4c91-9e20-7b58bf2a091e",
    "description": "Complete Postman collection for ExamPlatform APIs covering registration/login, Admin CRUD, Student execution, autosave, analytics, role-aware exam-list caching, and authenticated document previews with user-bound signed URLs.",
