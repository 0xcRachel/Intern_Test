    {
      "name": "Student - Exam Execution, Autosave & Results",
      "item": [
        {
          "name": "Start Exam Attempt",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.id) {",
                  "    pm.collectionVariables.set('attempt_id', jsonData.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{student_token}}"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/exams/{{exam_id}}/attempts",
              "host": ["{{base_url}}"],
              "path": ["exams", "{{exam_id}}", "attempts"]
            }
          }
        },
        {
          "name": "Autosave Attempt Answers",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{student_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"answers\": [\n        {\"question_id\": 1, \"option_id\": 1}\n    ]\n}"
            },
            "url": {
              "raw": "{{base_url}}/attempts/{{attempt_id}}/save",
              "host": ["{{base_url}}"],
              "path": ["attempts", "{{attempt_id}}", "save"]
            }
          }
        },
        {
          "name": "Resume In-Progress Attempt",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{student_token}}"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/attempts/{{attempt_id}}/resume",
              "host": ["{{base_url}}"],
              "path": ["attempts", "{{attempt_id}}", "resume"]
            }
          }
        },
        {
          "name": "Submit Exam Attempt",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{student_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"answers\": [\n        {\"question_id\": 1, \"option_id\": 1}\n    ]\n}"
            },
            "url": {
              "raw": "{{base_url}}/attempts/{{attempt_id}}/submit",
              "host": ["{{base_url}}"],
              "path": ["attempts", "{{attempt_id}}", "submit"]
            }
          }
        },
        {
          "name": "Get Attempt Results",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{student_token}}"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/attempts/{{attempt_id}}",
              "host": ["{{base_url}}"],
              "path": ["attempts", "{{attempt_id}}"]
            }
          }
        }
