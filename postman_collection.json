    {
      "name": "IELTS Flow - Packages & Document Previews",
      "item": [
        {
          "name": "List Packages with Units & Documents",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.data && jsonData.data[0]) {",
                  "    var pkg = jsonData.data[0];",
                  "    pm.collectionVariables.set('package_id', pkg.id);",
                  "    if (pkg.units && pkg.units[0] && pkg.units[0].documents && pkg.units[0].documents[0]) {",
                  "        pm.collectionVariables.set('document_id', pkg.units[0].documents[0].id);",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/packages",
              "host": ["{{base_url}}"],
              "path": ["packages"]
            }
          }
        },
        {
          "name": "Get Package Details",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/packages/{{package_id}}",
              "host": ["{{base_url}}"],
              "path": ["packages", "{{package_id}}"]
            }
          }
        },
        {
          "name": "Request Time-Boxed Document Preview URL",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "pm.test('preview URL is signed', function () { pm.expect(jsonData.preview_url).to.include('signature='); });",
                  "pm.test('preview URL is user-bound', function () { pm.expect(jsonData.preview_url).to.include('user='); });",
                  "if (jsonData.preview_url) { pm.collectionVariables.set('preview_url', jsonData.preview_url); }"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{student_token}}"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/documents/{{document_id}}/preview",
              "host": ["{{base_url}}"],
              "path": ["documents", "{{document_id}}", "preview"]
            }
          }
        },
        {
          "name": "Stream Signed Preview (No Bearer Token)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{preview_url}}"
            }
          }
        }
      ]
    }
  ]
}
